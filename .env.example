# Copy to .env.local for `npm run dev`. Never commit .env.local.
# On Hugging Face Spaces, set these in Space Settings instead (see README).

# --- Browser-visible (OK to ship to the client) ---
# Supabase → Project Settings → API
# Use the publishable key (sb_publishable_…) or legacy anon key.
# Never use the service_role / secret key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# --- Server-only (HF Space Secrets, not Variables) ---
# https://huggingface.co/settings/tokens  (fine-grained token with Inference)
HUGGINGFACE_API_KEY=hf_your_token
# https://api-dashboard.search.brave.com/app/documentation/web-search/get-started
BRAVE_SEARCH_API_KEY=your_brave_search_api_key

# --- Optional ---
# Chat model for /api/search. Default is Qwen/Qwen2.5-72B-Instruct.
# HF_MODEL=Qwen/Qwen2.5-72B-Instruct
