{
  "name": "unihunt",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "test": "vitest",
    "e2e:setup": "node scripts/testDbSetup.js",
    "e2e:teardown": "node scripts/testDbTeardown.js",
    "e2e": "npx playwright install --with-deps && npm run e2e:setup && npx playwright test && npm run e2e:teardown"
  },
  "dependencies": {
    "@huggingface/inference": "^1.0.0",
    "@supabase/supabase-js": "^2.0.0",
    "@tanstack/react-table": "^8.8.5",
    "clsx": "^1.2.1",
    "next": "14.2.35",
    "nodemailer": "^6.9.4",
    "pg": "^8.11.0",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/node": "22.20.2",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "19.3.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.0.0",
    "eslint-config-next": "14.2.35",
    "postcss": "^8.4.0",
    "tailwindcss": "3.4.19",
    "typescript": "5.4.2",
    "vitest": "^1.0.0"
  }
}
